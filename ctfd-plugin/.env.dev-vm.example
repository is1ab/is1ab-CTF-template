# dev CTFd（docker-compose.dev-vm.yml）用的環境變數範本。
#
# 用法：複製成同目錄的 .env（.env 已被 .gitignore 擋，不會進 repo）。
#   cp .env.dev-vm.example .env  &&  編輯 .env
# docker compose 會自動載入「執行時工作目錄」下的 .env，故務必在 ctfd-plugin/ 目錄裡跑 compose。

# ── 必填 ──────────────────────────────────────────────────────────────
# CTFd session 簽章金鑰。設成一段夠長的隨機字串。
# ⚠️ 改這個值會讓所有現有登入 session 失效（要重新登入）；DB 資料不受影響。
#    產生：openssl rand -hex 32
CTFD_DEV_SECRET_KEY=change-me-to-a-long-random-string

# ── 選填 ──────────────────────────────────────────────────────────────
# dev DB 密碼（預設 ctfd）。DB 僅容器內部、不對外，一般不用改。
# CTFD_DEV_DB_PASSWORD=ctfd

# 題面送審的獨立指紋金鑰；使用 openssl rand -hex 32 產生，不可沿用 CTFD_DEV_SECRET_KEY。
# 不設定時仍可編輯草稿，但送審會提示維運完成設定。
IS1AB_REVIEW_FINGERPRINT_KEY=
