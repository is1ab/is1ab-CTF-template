# =============================================================================
# 🔒 CTF Challenge Private Configuration
# =============================================================================
# ⚠️ 含敏感資訊，永不同步到 public repo。欄位定義見 docs/challenge-schema.md。
# =============================================================================

# ---- 必填 --------------------------------------------------------------------
flag: "${FLAG_PLACEHOLDER}"
# 多個可接受 flag（任一命中即解）可用陣列：
# flag:
#   - "is1abCTF{alt_1}"
#   - "is1abCTF{alt_2}"

# ---- flag 三軸（選填，皆有預設；三者正交）-----------------------------------
flag_load: "static"     # static（內建）| dynamic（部署時從 .env/generator 注入）
flag_scope: "shared"    # shared（統一）| per_team（唯一，隱含 flag_load=dynamic）
flag_match: "exact"     # exact | regex（→ 對應 CTFd flag type）

# 動態 flag 設定（僅 flag_load: dynamic）
# dynamic_flag:
#   template: "is1abCTF{${TEAM_ID}_${RANDOM_SUFFIX}}"
#   salt: "${RANDOM_SALT}"

# ---- 其他選填 ----------------------------------------------------------------
# 開發筆記（敏感）
internal_notes: |
  TODO: 開發筆記、測試要點、已知問題

# 驗題記錄
testing:
  tested_by: "${AUTHOR}"
  last_tested: "${CURRENT_DATE}"
  test_status: "pending"   # pending | passed | failed

# =============================================================================
# 解題說明放哪（不塞進 YAML）：
#   • 可自動驗證的官方解 → solution/exploit.py（契約見 scripts/verify-solution.py）
#   • 解題文件 / flag 位置 / 測試帳密 → writeup/README.md
#   • 密鑰（DB 密碼 / secret_key 等）→ .env / secret manager，絕不進 YAML 或 CTFd DB
# =============================================================================
