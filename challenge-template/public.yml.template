# =============================================================================
# 📢 CTF Challenge Public Configuration
# =============================================================================
# ✅ 公開資訊，可安全同步到 public repo。❌ 不含 flag / 解答 / 敏感資訊。
# 欄位定義見 docs/challenge-schema.md（canonical）。
# =============================================================================

# ---- 必填 --------------------------------------------------------------------
title: "${CHALLENGE_TITLE}"
author: "${AUTHOR}"                 # GitHub username；唯一的人員欄位
difficulty: "${DIFFICULTY}"        # baby | easy | middle | hard | impossible
category: "${CATEGORY}"            # 自由填；建議 web/pwn/reverse/crypto/forensic/misc/osint/general
description: |
  ${CHALLENGE_DESCRIPTION}

# 交付方式（只講「有沒有服務」；連線方式在 deploy_info.connection_type）
#   attachment = 只給檔案 ; container = 有服務 ; none = 純知識/OSINT，無部署無附件
deploy_type: "${DEPLOY_TYPE}"
source_code_provided: false        # 是否附原始碼

# ---- 選填 --------------------------------------------------------------------
points: ${POINTS}

tags:
  - "${CATEGORY}"

# 提供給參賽者的檔案（container/nc 題也能附檔）
files: []
  # - "challenge.zip"

status: "developing"               # planning | developing | testing | completed | deployed
ready_for_release: false

created_at: "${CURRENT_DATE}"
updated_at: "${CURRENT_DATE}"

# 部署資訊（有服務才需要）
deploy_info:
  # connection_type: "nc"          # nc | http | https —— 玩家怎麼連
  # port: 8080
  # nc_port: 9999                  # connection_type=nc 時
  # timeout: 60
  requires_build: true
  # resources: { memory: "256Mi", cpu: "100m" }

# 提示（level/cost/content）
hints:
  - level: 1
    cost: 0
    content: |
      TODO: 第一個提示（免費），引導方向但不透露答案

# 公開 repo 檔案白名單（選填；有安全用途，控制哪些檔案進 public）
# allowed_files:
#   - "src/**"
#   - "files/*.zip"

# =============================================================================
# ✅ 發布前檢查：無 flag / 無解題步驟 / 無測試憑證 / 無內部筆記 / description 無洩漏
# 學習目標 / 所需技能 / 推薦工具 / 參考資料等說明 → 寫進 writeup/README.md，不進此檔
# =============================================================================
